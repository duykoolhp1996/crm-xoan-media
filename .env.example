# =======================================================
# CRM Xoăn Media - Environment Configuration Template
# Không commit file .env chứa thông tin bí mật vào Git
# =======================================================

# 1. Server & Cổng dịch vụ
PORT=4321
NODE_ENV=production
API_BASE_URL=/api

# 2. Database Server (SQLite Persistent / Single Source of Truth)
# Lưu ý: Database production được đặt tại server/data/ và không bao giờ bị xóa khi deploy
DB_PATH=/home/minh/crm-xoan-media/server/data/crm_xoan_server.db
DB_BACKUP_DIR=/home/minh/crm-xoan-media/server/backups/db
BACKUP_RETENTION_DAYS=30

# 3. Khóa an toàn Production (Production Safety Lock)
# Mặc định = false để ngăn chặn các lệnh DROP TABLE, TRUNCATE hoặc RESET DATABASE
ALLOW_DESTRUCTIVE_DATABASE_OPERATION=false

# 4. Bảo mật & Xác thực
JWT_SECRET=xoan_media_production_secret_key_2026_change_in_prod

# 5. Đồng bộ Google Sheets
GOOGLE_SPREADSHEET_ID=1gbo1qA04CLJdaEsmxqudzPYdrtoAyLdVSk4AoDmo3nU

# 6. Supabase Cloud (Replica đám mây)
VITE_SUPABASE_URL=https://etvbrbdysphrfzvnwvbk.supabase.co
VITE_SUPABASE_ANON_KEY=
