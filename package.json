{
  "name": "crm-xoan-media",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "deploy": "npm run build && cp dist/index.html dist/404.html && touch dist/.nojekyll && npx -y gh-pages -d dist -b gh-pages",
    "deploy:server": "npm run build && rsync -avz --exclude 'node_modules' --exclude '.git' ./dist/ minh@192.168.2.47:/var/www/crm-xoan-media/ && echo '✅ Đã deploy lên server nội bộ http://192.168.2.47 thành công!'"
  },
